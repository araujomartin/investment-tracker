generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Asset {
  id        String   @id @default(uuid())
  ticker    String   @unique
  name      String
  type      AssetType
  ratioDiv  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@map("assets")
}

enum AssetType {
  CEDEARS
  ACTION
  SHARE
  CRYPTO
  FIAT
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String
  assetId         String
  ticker          String
  type            TransactionType
  quantity        Float
  pricePerShareArs Float
  usdArsRate      Float
  totalUsd        Float
  ratio           Int             @default(1)
  transactionDate DateTime
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([userId])
  @@index([ticker])
  @@index([transactionDate])
  @@map("transactions")
}

enum TransactionType {
  BUY
  SELL
  SPLIT
  DIVIDEND
}
